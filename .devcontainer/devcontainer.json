{
  "name": "ptlabel – Etikettenprogramm für Brother PT-P750W",
  "build": { "dockerfile": "Dockerfile" },

  // USB-Zugriff auf den Drucker (auch wenn er erst nach dem Start eingesteckt wird)
  // und X11-Socket für die Qt-Oberfläche
  "runArgs": [
    "--device-cgroup-rule=c 189:* rmw"
  ],
  "mounts": [
    "source=/dev/bus/usb,target=/dev/bus/usb,type=bind",
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
  ],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "QT_QPA_PLATFORM": "xcb"
  },

  "postCreateCommand": "pip install --user -e '.[dev]'",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "anthropic.claude-code"

      ]
    }
  },

  "remoteUser": "vscode"
}
