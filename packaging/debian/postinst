#!/bin/sh
# Richtet nach dem Entpacken die Python-Umgebung unter /opt/ptouch-editor ein.
set -e

APP=/opt/ptouch-editor

if [ "$1" = "configure" ]; then
    echo "Ptouch Editor: richte Python-Umgebung ein (lädt PySide6 & Co., einige Minuten) …"
    rm -rf "$APP/venv"
    python3 -m venv "$APP/venv"
    if ! "$APP/venv/bin/pip" install --disable-pip-version-check --no-cache-dir --quiet \
            "$APP"/wheels/ptlabel-*.whl; then
        echo "Fehler: Die Python-Pakete konnten nicht geladen werden." >&2
        echo "Bitte Internetverbindung prüfen und danach erneut versuchen mit:" >&2
        echo "    sudo dpkg --configure -a" >&2
        exit 1
    fi
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database -q /usr/share/applications || true
    fi
    if command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -q -f /usr/share/icons/hicolor || true
    fi
    echo "Ptouch Editor ist installiert: im Startmenü unter „Büro“ oder mit „ptouch-editor“."
fi

exit 0
